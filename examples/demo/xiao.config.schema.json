{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "site",
    "theme",
    "seo"
  ],
  "properties": {
    "version": {
      "type": "number"
    },
    "site": {
      "type": "object",
      "required": [
        "url",
        "base",
        "lang",
        "title",
        "description"
      ],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "base": {
          "type": "string",
          "minLength": 1
        },
        "lang": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      }
    },
    "theme": {
      "type": "object",
      "required": [
        "hue"
      ],
      "properties": {
        "id": {
          "type": "string",
          "default": "default",
          "description": "主题：站点使用的版式，对应 src/theme.json 的 id。"
        },
        "palette": {
          "type": "string",
          "default": "midnight",
          "description": "主题配色：src/theme.json 里 palettes.items 的某个 id。省略时按 hue 派生色板。"
        },
        "mode": {
          "type": "string",
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "default": "auto",
          "description": "亮暗模式。"
        },
        "hue": {
          "type": "number",
          "minimum": 0,
          "maximum": 360,
          "default": 250,
          "description": "1.x 兼容字段：没有 preset / colors 时由它派生整套色板。"
        },
        "colors": {
          "type": "object",
          "description": "在预设基础上覆盖，缺省项取预设（无 preset 时仍由 hue 派生）。",
          "properties": {
            "light": {
              "$ref": "#/$defs/palette"
            },
            "dark": {
              "$ref": "#/$defs/palette"
            }
          }
        },
        "options": {
          "type": "object",
          "description": "主题自定义项，可用的键、类型与默认值见 src/theme.json 的 options。",
          "additionalProperties": {
            "type": [
              "string",
              "boolean",
              "array"
            ]
          }
        },
        "breakpoints": {
          "type": "array",
          "description": "响应式断点；省略时用内置默认（md=1023 平板、sm=767 手机），老内容不变。",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/breakpoint"
          }
        },
        "preset": {
          "type": "string",
          "enum": [
            "midnight",
            "paper",
            "magazine",
            "terminal",
            "warm",
            "minimal"
          ],
          "default": "midnight",
          "description": "旧键，只读兼容；Studio 保存时迁移到 palette。",
          "deprecated": true
        },
        "colorScheme": {
          "type": "string",
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "default": "auto",
          "deprecated": true,
          "description": "旧键，只读兼容；Studio 保存时迁移到 mode。"
        },
        "font": {
          "type": "string",
          "enum": [
            "sans",
            "serif",
            "mono",
            "custom",
            "mono-heading"
          ],
          "default": "sans",
          "deprecated": true,
          "description": "旧键，只读兼容；Studio 保存时迁移到 options.font。"
        },
        "fontStack": {
          "type": "string",
          "default": "",
          "description": "旧键，只读兼容；Studio 保存时迁移到 options.fontStack。",
          "deprecated": true
        },
        "scale": {
          "type": "string",
          "enum": [
            "compact",
            "normal",
            "spacious"
          ],
          "default": "normal",
          "deprecated": true,
          "description": "旧键，只读兼容；Studio 保存时迁移到 options.scale。"
        },
        "lineHeight": {
          "type": "string",
          "enum": [
            "tight",
            "normal",
            "loose"
          ],
          "default": "normal",
          "deprecated": true,
          "description": "旧键，只读兼容；Studio 保存时迁移到 options.lineHeight。"
        },
        "density": {
          "type": "string",
          "enum": [
            "compact",
            "normal"
          ],
          "default": "normal",
          "deprecated": true,
          "description": "旧键，只读兼容；Studio 保存时迁移到 options.density。"
        },
        "radius": {
          "type": "string",
          "enum": [
            "none",
            "sm",
            "md",
            "lg",
            "pill"
          ],
          "default": "md",
          "deprecated": true,
          "description": "旧键，只读兼容；Studio 保存时迁移到 options.radius。"
        },
        "contentWidth": {
          "type": "string",
          "enum": [
            "narrow",
            "prose",
            "wide",
            "full"
          ],
          "default": "prose",
          "deprecated": true,
          "description": "旧键，只读兼容；Studio 保存时迁移到 options.contentWidth。"
        },
        "shadow": {
          "type": "string",
          "enum": [
            "none",
            "soft",
            "strong"
          ],
          "default": "soft",
          "deprecated": true,
          "description": "旧键，只读兼容；Studio 保存时迁移到 options.shadow。"
        },
        "motion": {
          "type": "boolean",
          "default": true,
          "deprecated": true,
          "description": "旧键，只读兼容；Studio 保存时迁移到 options.motion。"
        }
      }
    }
  },
  "$defs": {
    "breakpoint": {
      "type": "object",
      "required": [
        "id",
        "maxWidth"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,16}$",
          "description": "类名前缀（x-<id>-* / x-hide-<id>）；建成后不允许改名。"
        },
        "label": {
          "type": "string",
          "description": "面板显示名，可改。"
        },
        "maxWidth": {
          "type": "integer",
          "minimum": 320,
          "maximum": 3840,
          "description": "该断点覆盖的最大宽度（含）。"
        }
      }
    },
    "palette": {
      "type": "object",
      "description": "色板覆盖项，均可不填。",
      "properties": {
        "accent": {
          "type": "string"
        },
        "accentInk": {
          "type": "string"
        },
        "accentSoft": {
          "type": "string"
        },
        "onAccent": {
          "type": "string"
        },
        "bg": {
          "type": "string"
        },
        "surface": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "text2": {
          "type": "string"
        },
        "text3": {
          "type": "string"
        },
        "line": {
          "type": "string"
        },
        "scrim": {
          "type": "string"
        }
      }
    }
  }
}
