---
import Hero from '../components/site/Hero.astro';
import PostCard from '../components/site/PostCard.astro';
import PageLayout from '../layouts/PageLayout.astro';
import { withBase } from '../lib/base';
import { loadConfig, resolveOptions } from '../lib/config';
import { publishedPosts } from '../lib/posts';
import { websiteHeads } from '../lib/seo';

const config = loadConfig();
const posts = await publishedPosts();
const heads = websiteHeads();
const { featuredFirst } = resolveOptions(config);
const hero = config.site.heroImage?.trim();
const avatar = config.author.avatar?.trim() ?? '';
const subtitle = config.site.subtitle?.trim() ?? '';
const display = subtitle || config.site.title;
---

<PageLayout
  title={config.site.title}
  description={config.site.description}
  heads={heads}
  sidebar="right"
  page="index"
>
  <Fragment slot="hero">
    <Hero src={hero && withBase(hero)} size="large">
      <div class="hero-identity">
        {avatar && <img class="hero-avatar" src={withBase(avatar)} alt="" />}
        <div>
          {subtitle && <p class="hero-kicker">{config.site.title}</p>}
          <h1>{display}</h1>
          {config.author.bio && <p class="hero-bio">{config.author.bio}</p>}
        </div>
      </div>
    </Hero>
  </Fragment>
  <ol class="post-card-list">
    {posts.map((post, index) => <PostCard post={post} featured={featuredFirst && index === 0} />)}
  </ol>
</PageLayout>
