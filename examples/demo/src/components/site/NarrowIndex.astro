---
/** 窄屏下替代侧栏标签云与归档：页脚上方两行可横向滑动的年份条和标签条，跟随 widgets 开关。 */
import { withBase } from '../../lib/base';
import { resolveOptions } from '../../lib/config';
import { publishedPosts, tagsOf } from '../../lib/posts';

const widgets = new Set(resolveOptions().widgets);
const posts = await publishedPosts();
const years = new Map<string, number>();
for (const post of posts) {
  const year = post.data.date.slice(0, 4);
  years.set(year, (years.get(year) ?? 0) + 1);
}
const tags = widgets.has('tags') ? tagsOf(posts).sort((a, b) => b.count - a.count) : [];
const showYears = widgets.has('archive') && years.size > 0;
---

{(showYears || tags.length > 0) && (
  <nav class="narrow-index" aria-label="归档与标签">
    {showYears && (
      <div class="narrow-index-row">
        <span class="narrow-index-label">归档</span>
        <div class="narrow-index-items">
          {[...years.entries()].map(([year, count]) => (
            <a class="narrow-index-year" href={withBase(`archives/#${year}`)}>
              {year}
              <span>{count}</span>
            </a>
          ))}
        </div>
      </div>
    )}
    {tags.length > 0 && (
      <div class="narrow-index-row">
        <span class="narrow-index-label">标签</span>
        <div class="narrow-index-items">
          {tags.map((tag) => (
            <a href={withBase(`tags/${encodeURIComponent(tag.name)}/`)}>#{tag.name}</a>
          ))}
        </div>
      </div>
    )}
  </nav>
)}
