---
import SiteNav from '../xiao/SiteNav.astro';
import SiteSearchButton from '../xiao/SiteSearchButton.astro';
import SiteThemeToggle from '../xiao/SiteThemeToggle.astro';
import SiteTitle from '../xiao/SiteTitle.astro';
---

<header class="topbar">
  <SiteTitle />
  <SiteNav />
  <SiteSearchButton />
  <SiteThemeToggle />
  <details class="nav-drawer">
    <summary class="icon-btn" aria-label="打开导航">
      <svg class="drawer-open-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
      <svg class="drawer-close-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M6 6l12 12M18 6 6 18"></path>
      </svg>
    </summary>
    <div class="drawer-mask"></div>
    <div class="drawer-panel">
      <SiteNav variant="drawer" class="drawer-nav" />
    </div>
  </details>
  <script is:inline>
    document.querySelectorAll('.topbar .theme-toggle').forEach((button) => {
      button.addEventListener('click', () => {
        const root = document.documentElement;
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        localStorage.setItem('xiao-theme', next);
      });
    });
    document.querySelectorAll('.nav-drawer').forEach((drawer) => {
      const summary = drawer.querySelector('summary');
      drawer.addEventListener('toggle', () => {
        summary?.setAttribute('aria-label', drawer.open ? '收起导航' : '打开导航');
      });
      drawer.querySelector('.drawer-mask')?.addEventListener('click', () => {
        drawer.open = false;
      });
    });
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      document.querySelectorAll('.nav-drawer[open]').forEach((drawer) => {
        drawer.open = false;
        drawer.querySelector('summary')?.focus();
      });
    });
  </script>
</header>
