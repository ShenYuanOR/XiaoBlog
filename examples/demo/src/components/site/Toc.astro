---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  headings?: Heading[];
}
const { headings = [] } = Astro.props;
---

{headings.length > 0 && (
  <nav class="toc">
    <details open>
      <summary>目录</summary>
      <ul>
        {headings
          .filter((heading) => heading.depth <= 3)
          .map((heading) => (
            <li>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))}
      </ul>
    </details>
  </nav>
)}
