---
/**
 * 顶部横幅：版心右上角一个大笔尖（从上沿伸入），笔尖宽度 = 曲线宽度，曲线从底边扫进笔尖，呈山谷感；
 * 背景铺满灰色二进制数字。静态插画，不做动画；插画和底纹分别由主题自定义项 heroArt / heroBits 开关。
 * 颜色只用 --hero-bg / --hero-ink / --hero-digit，随亮暗主题反转：暗色黑底白笔，浅色白底黑笔。
 * 有题图或文章封面时显示图片，不画插画。
 */
import { resolveOptions } from '../../lib/config';

interface Props {
  /** 已经是最终可用地址（调用方负责 withBase/图片管线），留空显示笔尖插画。 */
  src?: string;
  size?: 'large' | 'medium' | 'small';
  alt?: string;
  class?: string;
}
const { src: rawSrc, size = 'small', alt = '', class: extraClass } = Astro.props;
const src = rawSrc?.trim() ?? '';
const { heroArt, heroBits } = resolveOptions();

/** 坐标系 900×600。笔尖按 NIB_SCALE 放大，曲线描边 = 笔尖平边宽度 × 放大倍数。 */
const NIB_SCALE = 1.8;
const NIB_EDGE = 34;
const TIP = { x: 700, y: 210 };
/** 尾巴远伸到画框下方，任何高度的 Hero 都由下沿裁断，像从底边延伸上来的山谷。 */
const CURVE = `M20 1100 C40 700 240 505 430 456 C580 418 675 375 ${TIP.x} ${TIP.y}`;

/** 背景二进制：构建期确定性伪随机，用 textLength 把每行撑满图块宽度。 */
const TILE_W = 480;
const ROW_H = 20;
const ROWS = 12;
const COLS = 60;
let seed = 0x5eed;
function random(): number {
  seed = (seed + 0x6d2b79f5) | 0;
  let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
}
const bits = Array.from({ length: ROWS }, () =>
  Array.from({ length: COLS }, () => (random() < 0.5 ? '1' : '0')).join(''),
);
---

<header class:list={['hero', `hero-${size}`, src && 'hero-has-image', extraClass]}>
  {
    src ? (
      <>
        <img class="hero-img" src={src} alt={alt} />
        <div class="hero-scrim" aria-hidden="true" />
      </>
    ) : (
      <>
        {heroBits && (
        <svg class="hero-bits" aria-hidden="true" focusable="false">
          <defs>
            <pattern id="hero-bits" width={TILE_W} height={ROW_H * ROWS} patternUnits="userSpaceOnUse">
              {bits.map((line, row) => (
                <text x="0" y={ROW_H * row + 14} textLength={TILE_W} lengthAdjust="spacing">
                  {line}
                </text>
              ))}
            </pattern>
          </defs>
          <rect width="100%" height="100%" fill="url(#hero-bits)" />
        </svg>
        )}
        {heroArt && (
        <svg class="hero-art" viewBox="0 0 900 600" aria-hidden="true" focusable="false">
          <path class="hero-curve" d={CURVE} stroke-width={NIB_EDGE * NIB_SCALE} />
          <g transform={`translate(${TIP.x} ${TIP.y}) rotate(20) scale(${NIB_SCALE})`}>
            <path
              class="nib"
              d={`M${-NIB_EDGE / 2} 0 L${NIB_EDGE / 2} 0 C22 -30 34 -55 36 -85 C38 -115 33 -138 30 -150 L-30 -150 C-33 -138 -38 -115 -36 -85 C-34 -55 -22 -30 ${-NIB_EDGE / 2} 0 Z M-30 -150 L30 -150 L32 -240 L-32 -240 Z`}
            />
            <path class="nib-cut" d="M0 -2 L0 -66" />
            <circle class="nib-hole" cx="0" cy="-75" r="6.5" />
            <path
              class="nib-cut nib-cut-thin"
              d="M-24 -104 C-12 -96 12 -96 24 -104 M-20 -120 C-8 -112 8 -112 20 -120 M-28 -150 L28 -150"
            />
          </g>
        </svg>
        )}
      </>
    )
  }
  <div class="hero-content">
    <slot />
  </div>
</header>
