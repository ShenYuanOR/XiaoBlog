---
const { pad, bg, hideOn, ...rest } = Astro.props;
const hide = Array.isArray(hideOn) ? hideOn : hideOn ? [hideOn] : [];
const classes = [
  'x-box',
  pad ? `x-pad-${pad}` : '',
  bg ? `x-bg-${bg}` : '',
  ...hide.map((item) => `x-hide-${item}`),
]
  .filter(Boolean)
  .join(' ');
const { href } = Astro.props;
---

<article class:list={[classes, 'x-card']} {...rest}>
  {href ? (
    <a class="x-link" href={href}>
      <slot />
    </a>
  ) : (
    <slot />
  )}
</article>
