  "options": [
    {
      "key": "font",
      "group": "排版",
      "label": "字体",
      "type": "select",
      "default": "sans",
      "choices": [
        { "value": "sans", "label": "无衬线（系统）" },
        { "value": "serif", "label": "衬线" },
        { "value": "mono", "label": "等宽" },
        { "value": "custom", "label": "自定义字体栈" }
      ]
    },
    {
      "key": "fontStack",
      "group": "排版",
      "label": "自定义字体栈",
      "type": "text",
      "default": "",
      "placeholder": "'LXGW WenKai', 'Songti SC', serif",
      "when": { "key": "font", "value": "custom" }
    },
    {
      "key": "scale",
      "group": "排版",
      "label": "字号",
      "hint": "同时缩放字号与间距，按钮、卡片、正文一起变。",
      "type": "segmented",
      "default": "normal",
      "choices": [
        { "value": "compact", "label": "紧凑" },
        { "value": "normal", "label": "标准" },
        { "value": "spacious", "label": "宽松" }
      ]
    },
    {
      "key": "lineHeight",
      "group": "排版",
      "label": "行高",
      "type": "segmented",
      "default": "normal",
      "choices": [
        { "value": "tight", "label": "紧" },
        { "value": "normal", "label": "标准" },
        { "value": "loose", "label": "松" }
      ]
    },
    {
      "key": "density",
      "group": "排版",
      "label": "密度",
      "hint": "只压缩间距，不缩字号。",
      "type": "segmented",
      "default": "normal",
      "choices": [
        { "value": "compact", "label": "紧凑" },
        { "value": "normal", "label": "标准" }
      ]
    },
    {
      "key": "contentWidth",
      "group": "排版",
      "label": "正文宽度",
      "type": "select",
      "default": "prose",
      "choices": [
        { "value": "narrow", "label": "窄（560px）" },
        { "value": "prose", "label": "标准（720px）" },
        { "value": "wide", "label": "宽（1200px）" },
        { "value": "full", "label": "通栏" }
      ]
    },
    {
      "key": "radius",
      "group": "质感",
      "label": "圆角",
      "type": "select",
      "default": "md",
      "choices": [
        { "value": "none", "label": "无圆角" },
        { "value": "sm", "label": "小（6px）" },
        { "value": "md", "label": "中（12px）" },
        { "value": "lg", "label": "大（20px）" },
        { "value": "pill", "label": "胶囊" }
      ]
    },
    {
      "key": "shadow",
      "group": "质感",
      "label": "阴影",
      "type": "select",
      "default": "soft",
      "choices": [
        { "value": "none", "label": "无阴影" },
        { "value": "soft", "label": "柔和" },
        { "value": "strong", "label": "强烈" }
      ]
    },
    {
      "key": "motion",
      "group": "质感",
      "label": "过渡动效",
      "hint": "关闭后悬停等过渡瞬间完成；系统开了减少动态效果时始终关闭。",
      "type": "switch",
      "default": true
    },
    {
      "key": "heroArt",
      "group": "横幅",
      "label": "笔尖插画",
      "hint": "站点设置里配了题图、或文章有封面时，横幅显示图片，不画插画。",
      "type": "switch",
      "default": true
    },
    {
      "key": "heroBits",
      "group": "横幅",
      "label": "二进制底纹",
      "type": "switch",
      "default": true
    },
    {
      "key": "featuredFirst",
      "group": "首页",
      "label": "放大最新一篇",
      "type": "switch",
      "default": true
    },
    {
      "key": "announcement",
      "group": "侧栏",
      "label": "公告",
      "hint": "留空不显示公告。窄屏下显示为作者信息下方的一行横幅。",
      "type": "textarea",
      "default": ""
    },
    {
      "key": "widgets",
      "group": "侧栏",
      "label": "侧栏挂件",
      "hint": "作者卡始终显示。窄屏下归档与标签合成页脚上方的滑动条，站点信息并入页脚。",
      "type": "checks",
      "default": ["recent", "tags", "archive", "stats"],
      "choices": [
        { "value": "recent", "label": "最新文章" },
        { "value": "tags", "label": "标签云" },
        { "value": "archive", "label": "归档" },
        { "value": "stats", "label": "站点信息" }
      ]
    }
  ]
}
