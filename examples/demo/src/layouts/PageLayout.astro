---
import Base from './BaseLayout.astro';
import SideTree from '../components/site/SideTree.astro';
import { categoriesOf, publishedPosts } from '../lib/posts';
import type { HeadEntry } from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  heads?: HeadEntry[];
}
const { title, description, heads = [] } = Astro.props;
const posts = await publishedPosts();
---

<Base title={title} description={description} heads={heads}>
  <div class="shell">
    <SideTree categories={categoriesOf(posts)} />
    <div class="prose">
      <h1>{title}</h1>
      <slot />
    </div>
  </div>
</Base>
