{
  "name": "xiao",
  "version": "0.3.1",
  "repo": "ShenYuanOR/XiaoBlog",
  "branch": "master",
  "description": "「晓」更新清单：仅 core 随 xiao:update 覆盖；theme 为默认参考实现（不自动更新，需自行比对合并）；user 永不触碰。",
  "core": [
    ".vitepress/engine/**",
    ".vitepress/config.ts",
    ".vitepress/shims.d.ts",
    ".vitepress/theme/index.ts",
    ".vitepress/theme/icons.ts",
    ".vitepress/theme/posts.data.ts",
    ".vitepress/theme/data.ts",
    ".vitepress/theme/mdi-subset.json",
    "scripts/new.mjs",
    "scripts/tidy.mjs",
    "scripts/validate.mjs",
    "scripts/gen-redirects.mjs",
    "scripts/gen-icons.mjs",
    "scripts/migrate.mjs",
    "scripts/annotate.mjs",
    "scripts/xiao-update.mjs",
    ".github/**",
    "package.json",
    "pnpm-workspace.yaml",
    "tsconfig.json",
    ".gitignore",
    "framework-manifest.json"
  ],
  "theme": [
    ".vitepress/theme/styles/**",
    ".vitepress/theme/Layout.vue",
    ".vitepress/theme/views/**",
    ".vitepress/theme/components/**"
  ],
  "user": [
    "docs/**",
    "public/**",
    "redirects/**",
    ".vitepress/site.config.ts",
    ".vitepress/blog.config.ts",
    "README.md",
    "LICENSE"
  ]
}
