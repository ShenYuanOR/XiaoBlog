---
import Base from './BaseLayout.astro';
import SideTree from '../components/site/SideTree.astro';
import { publishedPosts } from '../lib/posts';
import type { HeadEntry } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  heads?: HeadEntry[];
  showHeading?: boolean;
  /** 页面标识：透传给 BaseLayout 的 <body data-page> 与按页样式表查找。 */
  page?: string;
}
const { title, description, heads = [], showHeading = true, page } = Astro.props;
const posts = await publishedPosts();
---

<Base title={title} description={description} heads={heads} page={page}>
  <div class="shell">
    <aside class="side side-desktop">
      <SideTree posts={posts} />
    </aside>
    <main class="page-body">
      {showHeading && title && <h1>{title}</h1>}
      <slot />
    </main>
  </div>
</Base>
