---
import Base from './BaseLayout.astro';
import Hero from '../components/site/Hero.astro';
import NarrowBrief from '../components/site/NarrowBrief.astro';
import NarrowIndex from '../components/site/NarrowIndex.astro';
import RecentPostsWidget from '../components/site/widgets/RecentPostsWidget.astro';
import PageShell from '../components/xiao/PageShell.astro';
import PostLicense from '../components/xiao/PostLicense.astro';
import PostMeta from '../components/xiao/PostMeta.astro';
import PostTags from '../components/xiao/PostTags.astro';
import PostTitle from '../components/xiao/PostTitle.astro';
import Sidebar from '../components/site/Sidebar.astro';
import Toc from '../components/site/Toc.astro';
import { withBase } from '../lib/base';
import { loadConfig } from '../lib/config';
import type { PostEntry } from '../lib/posts';
import { articleHeads } from '../lib/seo';

interface Props {
  post: PostEntry;
  headings: { depth: number; slug: string; text: string }[];
  prev?: PostEntry;
  next?: PostEntry;
  /** 页面标识：默认不用传，posts/[...slug].astro 会传文章 id。 */
  page?: string;
  /** 版式根节点的附加 class。 */
  class?: string;
}
const { post, headings, page, class: extraClass } = Astro.props;
const config = loadConfig();
const heads = articleHeads({
  slug: post.id,
  title: post.data.title,
  description: post.data.description ?? post.data.title,
  date: post.data.date,
  updated: post.data.updated,
  tags: post.data.tags,
  noindex: post.data.noindex,
});
const cover = post.format === 'md' ? post.data.cover : undefined;
const coverSrc =
  cover && typeof cover === 'object' && 'src' in cover ? (cover as { src: string }).src : undefined;
const siteHero = config.site.heroImage?.trim();
const heroSrc = coverSrc ?? (siteHero ? withBase(siteHero) : undefined);
---

<Base title={post.data.title} description={post.data.description} heads={heads} page={page}>
  <Hero src={heroSrc} size="medium">
    <PostTitle post={post} />
    <PostMeta post={post} separator="" />
  </Hero>
  <NarrowBrief />
  <PageShell sidebar="right" class={extraClass}>
    <Sidebar slot="side" headings={headings} exclude={post.id} />
    <article class="prose">
      <Toc headings={headings} mobile />
      <slot />
      <PostTags post={post} />
      <PostLicense />
    </article>
    <div class="narrow-more">
      <RecentPostsWidget exclude={post.id} limit={3} title="继续阅读" />
    </div>
  </PageShell>
  <NarrowIndex />
</Base>
