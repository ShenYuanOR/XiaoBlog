---
import { publishedPosts } from '../../lib/posts';
import SideTree from './SideTree.astro';
import SiteNav from '../xiao/SiteNav.astro';
import SiteSearchButton from '../xiao/SiteSearchButton.astro';
import SiteThemeToggle from '../xiao/SiteThemeToggle.astro';
import SiteTitle from '../xiao/SiteTitle.astro';

const posts = await publishedPosts();
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const current = posts.find((post) => path.endsWith(`/posts/${post.id}`))?.id;
---

<header class="topbar">
  <details class="nav-drawer">
    <summary class="icon-btn" aria-label="打开菜单">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </summary>
    <div class="drawer-mask"></div>
    <div class="drawer-panel">
      <SiteNav variant="drawer" />
      <SideTree posts={posts} current={current} />
    </div>
  </details>
  <SiteTitle />
  <SiteNav />
  <SiteSearchButton />
  <SiteThemeToggle />
  <script is:inline>
    document.querySelectorAll('.topbar .theme-toggle').forEach((button) => {
      button.addEventListener('click', () => {
        const root = document.documentElement;
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        localStorage.setItem('xiao-theme', next);
      });
    });
    document.querySelectorAll('.nav-drawer').forEach((drawer) => {
      drawer.querySelector('.drawer-mask')?.addEventListener('click', () => {
        drawer.open = false;
      });
    });
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      document.querySelectorAll('.nav-drawer').forEach((drawer) => {
        drawer.open = false;
      });
    });
  </script>
</header>
