---
/** 主题切换按钮参数；点击脚本由 Header 统一绑定。 */
interface Props {
  class?: string;
}
const { class: extraClass } = Astro.props;
---

<button class:list={['icon-btn', 'theme-toggle', extraClass]} type="button" aria-label="切换主题">
  <svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M18.4 5.6 17 7M7 17l-1.4 1.4"></path>
  </svg>
  <svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M20 14.5A8 8 0 1 1 9.5 4 6.5 6.5 0 0 0 20 14.5z"></path>
  </svg>
</button>
