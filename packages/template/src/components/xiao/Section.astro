---
const { pad, bg, hideOn, class: extraClass, ...rest } = Astro.props;
const hide = Array.isArray(hideOn) ? hideOn : hideOn ? [hideOn] : [];
const classes = [
  'x-box',
  pad ? `x-pad-${pad}` : '',
  bg ? `x-bg-${bg}` : '',
  ...hide.map((item) => `x-hide-${item}`),
  extraClass,
]
  .filter(Boolean)
  .join(' ');
const { width = 'full' } = Astro.props;
---

<section class:list={[classes, `x-width-${width}`]} {...rest}>
  <slot />
</section>
