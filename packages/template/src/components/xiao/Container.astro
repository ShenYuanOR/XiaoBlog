---
const { pad, bg, hideOn, ...rest } = Astro.props;
const hide = Array.isArray(hideOn) ? hideOn : hideOn ? [hideOn] : [];
const classes = [
  'x-box',
  pad ? `x-pad-${pad}` : '',
  bg ? `x-bg-${bg}` : '',
  ...hide.map((item) => `x-hide-${item}`),
]
  .filter(Boolean)
  .join(' ');
const { width = 'prose', align = 'start' } = Astro.props;
---

<div class:list={[classes, `x-width-${width}`, `x-align-${align}`]} {...rest}>
  <slot />
</div>
