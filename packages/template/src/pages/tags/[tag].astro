---
import PostCard from '../../components/site/PostCard.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import { publishedPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await publishedPosts();
  const tags = new Set(posts.flatMap((post) => post.data.tags));
  return [...tags].map((tag) => ({ params: { tag }, props: { tag } }));
}

const { tag } = Astro.props;
const posts = (await publishedPosts()).filter((post) => post.data.tags.includes(tag));
---

<PageLayout title={tag} page="tags">
  <ol class="post-card-list">
    {posts.map((post) => <PostCard post={post} />)}
  </ol>
</PageLayout>
