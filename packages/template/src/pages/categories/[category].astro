---
import PostCard from '../../components/site/PostCard.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import { publishedPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await publishedPosts();
  const names = new Set(
    posts.map((post) => post.data.category).filter((name): name is string => Boolean(name)),
  );
  return [...names].map((category) => ({ params: { category }, props: { category } }));
}

const { category } = Astro.props;
const posts = (await publishedPosts()).filter((post) => post.data.category === category);
---

<PageLayout title={category} page="categories">
  <ol class="post-card-list">
    {posts.map((post) => <PostCard post={post} />)}
  </ol>
</PageLayout>
