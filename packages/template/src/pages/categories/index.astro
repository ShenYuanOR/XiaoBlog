---
import PageLayout from '../../layouts/PageLayout.astro';
import { categoriesOf, publishedPosts } from '../../lib/posts';
import { withBase } from '../../lib/base';

const categories = categoriesOf(await publishedPosts());
const max = Math.max(1, ...categories.map((item) => item.count));
function weight(count: number): number {
  return 1 + Math.min(1.4, count / max);
}
---

<PageLayout title="分类" page="categories">
  <div class="tag-cloud-page">
    {categories.map((item) => (
      <a href={withBase(`categories/${encodeURIComponent(item.name)}/`)} style={`--w:${weight(item.count)}`}>
        {item.name}
        <span>{item.count}</span>
      </a>
    ))}
  </div>
</PageLayout>
